<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Orbit's window: black from the very first moment, so opening the app starts in darkness
         and the planet-and-moon intro fades in from it, with no white flash before it. -->
    <style name="Theme.Companion2" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <!-- Android 12+ shows a launch screen with the app icon. Black, with an empty icon,
             so it looks like the start of the intro rather than a separate screen. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">0</item>
    </style>
</resources>
